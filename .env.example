# Скопіюй у .env.local і впиши значення. .env.local у git не потрапляє.
# Один файл на обидва застосунки: його читають і Nest (apps/api), і Next (apps/web).

# --- обов'язкове ---

# Рядок підключення до MongoDB і назва бази.
MONGODB_URI=
MONGODB_DB=

# Ключ для підпису сесій і гостьових кук. Мінімум 32 символи.
AUTH_SECRET=

# Ключ, яким детермінується персонаж дня.
DAILY_SECRET=

# Звідки бек дозволяє запити. Через кому, без пробілів і без слеша в кінці.
CORS_ORIGINS=

# Адреса самого беку. Від неї Better Auth будує посилання для входу
# і адресу, на яку Google повертає після авторизації.
AUTH_URL=

# Порт беку. Має збігатися з портом у NEXT_PUBLIC_API_URL.
PORT=

# Публічна адреса сховища картинок. Перша для сервера, друга для браузера.
PICS_URL=
NEXT_PUBLIC_PICS_URL=

# Адреса беку для фронта. Вшивається у збірку, після зміни потрібен передеплой.
NEXT_PUBLIC_API_URL=

# --- необов'язкове ---

# Вхід через Google. Без них лишається тільки вхід за посиланням на пошту.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Відправка листів. Локально краще лишити порожнім: тоді посилання для входу
# друкується в лог замість того, щоб слати справжні листи.
RESEND_API_KEY=

# Від кого приходять листи. Має дефолт, задавати не обов'язково.
MAIL_FROM=

# Домен для куки сесії, щоб вона працювала і на сайті, і на піддомені api.
# Локально НЕ задавати — інакше вхід на localhost мовчки зламається.
COOKIE_DOMAIN=

# Публічна адреса сайту для canonical і sitemap. Має дефолт.
NEXT_PUBLIC_SITE_URL=
