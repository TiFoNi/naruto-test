MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
AUTH_SECRET=replace-with-at-least-32-random-characters

# Cloudflare R2 — сховище для public/<гра>/full картинок (необов'язково)
# Без цих змінних картинки беруться локально з public/, як і раніше.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nandaguessr
# Публічна адреса бакета — її читають і фронт, і функції
VITE_PICS_URL=https://pub-XXXXXXXX.r2.dev
PICS_URL=https://pub-XXXXXXXX.r2.dev
