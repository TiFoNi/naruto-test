{
  "name": "naruto-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace @nanda/web",
    "build": "npm run build --workspace @nanda/api",
    "typecheck": "npm run typecheck --workspace @nanda/web",
    "data": "node scripts/build-data.mjs && node scripts/build-dota.mjs && node scripts/build-aot.mjs && node scripts/build-bleach.mjs && node scripts/build-tg.mjs && node scripts/build-berserk.mjs && node scripts/build-kny.mjs && node scripts/build-onepiece.mjs && node scripts/build-mk.mjs && node scripts/build-hxh.mjs && node scripts/build-bc.mjs && node scripts/build-jojo.mjs && node scripts/build-se.mjs && node scripts/build-ff.mjs && node scripts/build-manga.mjs && node scripts/build-dn.mjs && node scripts/build-avatar.mjs && node scripts/build-cards.mjs",
    "data:naruto": "node scripts/build-data.mjs",
    "data:dota": "node scripts/build-dota.mjs && node scripts/build-dota-abilities.mjs",
    "data:aot": "node scripts/build-aot.mjs",
    "data:bleach": "node scripts/build-bleach.mjs",
    "data:tg": "node scripts/build-tg.mjs",
    "data:berserk": "node scripts/build-berserk.mjs",
    "data:kny": "node scripts/build-kny.mjs",
    "data:onepiece": "node scripts/build-onepiece.mjs",
    "data:mk": "node scripts/build-mk.mjs",
    "data:hxh": "node scripts/build-hxh.mjs",
    "data:bc": "node scripts/build-bc.mjs",
    "data:jojo": "node scripts/build-jojo.mjs",
    "data:se": "node scripts/build-se.mjs",
    "data:ff": "node scripts/build-ff.mjs",
    "data:manga": "node scripts/build-manga.mjs",
    "data:dn": "node scripts/build-dn.mjs",
    "data:avatar": "node scripts/build-avatar.mjs",
    "cards": "node scripts/build-cards.mjs",
    "check:data": "node scripts/check-data.mjs",
    "mini": "node scripts/build-mini.mjs",
    "pics": "node --env-file-if-exists=.env.local scripts/upload-pics.mjs",
    "dev:api": "npm run dev --workspace @nanda/api",
    "build:api": "npm run build --workspace @nanda/api",
    "start": "node apps/api/dist/apps/api/src/main.js",
    "build:web": "npm run build --workspace @nanda/web",
    "brand": "node scripts/brand.mjs",
    "dictionary": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/fill-dictionary.mjs",
    "backfill:solved": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/backfill-solved.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@types/node": "^22.20.4",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  }
}
