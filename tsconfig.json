{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@nanda/game": [
        "./packages/game/src/specs.ts"
      ],
      "@nanda/game/data/*": [
        "./packages/game/data/*"
      ]
    }
  },
  "include": [
    "src",
    "api",
    "packages/game/src",
    "vite.config.ts"
  ]
}
