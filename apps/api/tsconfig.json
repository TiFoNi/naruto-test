{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "removeComments": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@nanda/core/*": ["../../packages/core/src/*"],
      "@nanda/game": ["../../packages/game/src/specs.ts"],
      "@nanda/game/data/*": ["../../packages/game/data/*"]
    }
  },
  "include": ["src/**/*", "../../packages/core/src/**/*", "../../packages/game/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
